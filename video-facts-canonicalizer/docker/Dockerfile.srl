FROM python:3.9-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv

# Install SRL dependencies
# Note: AllenNLP has specific version requirements
RUN pip install --no-cache-dir \
    allennlp==2.10.1 \
    allennlp-models==2.10.1 \
    uvicorn \
    fastapi

# Copy SRL service
COPY srl_service/ /srv/srl_service/

EXPOSE 8001

CMD ["uvicorn", "srl_service.app:app", "--host", "0.0.0.0", "--port", "8001"]
