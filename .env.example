# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/facts

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333

# SRL Service
SRL_ENDPOINT=http://localhost:8001/predict

# Entity Linking
REL_DATA_DIR=/data/rel
MIN_CONF_ACCEPT=0.75

# Pipeline Features
ENABLE_VERIFICATION=false
ENABLE_EMBEDDINGS=false

# Test Data Generator (Anthropic API)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
