FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv

# Install Python dependencies for the wrapper
RUN pip install --no-cache-dir uvicorn fastapi

# Copy HeidelTime resources
COPY resources/heideltime/ /srv/heideltime/

# Copy TimEx service
COPY timex_service/ /srv/timex_service/

EXPOSE 8002

CMD ["uvicorn", "timex_service.app:app", "--host", "0.0.0.0", "--port", "8002"]
