FROM python:3.9-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv

# Install SRL dependencies with spaCy
RUN pip install --no-cache-dir \
    "spacy>=3.7,<3.9" \
    "spacy-transformers>=1.2.0" \
    uvicorn \
    fastapi

# Download spaCy models (try transformer first, fallback to large/medium)
RUN python -m spacy download en_core_web_trf || \
    python -m spacy download en_core_web_lg || \
    python -m spacy download en_core_web_md

# Copy SRL service
COPY srl_service/ /srv/srl_service/

EXPOSE 8001

CMD ["uvicorn", "srl_service.app:app", "--host", "0.0.0.0", "--port", "8001"]
